# Test files
tests/
**/tests/
__tests__/
**/__tests__/
testdata/
**/testdata/
fixtures/
**/fixtures/
sample-data/
**/sample-data/

# Development files
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
*.log
.coverage
htmlcov/

# Docker files
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# Terraform files
terraform/
*.tf
*.tfstate
*.tfstate.*
*.tfvars
!terraform.tfvars.example

# Node modules (keep only what's needed for build)
node_modules/
**/node_modules/

# Git files
.git/
.gitignore
.gitattributes

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Documentation
*.md
!README.md
docs/

# Build artifacts (will be generated during build)
**/.next/
**/.output/
**/dist/
**/coverage/

# Native app files (not needed for API)
apps/native/

# System files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
tmp/
temp/
