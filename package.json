{
  "name": "dpmedia",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @dpmedia/infra dev",
    "dev:web": "pnpm --filter @dpmedia/infra dev",
    "dev:arts": "pnpm --filter @dpmedia/infra dev",
    "dev:native": "turbo run dev --filter=native",
    "dev:all": "pnpm --filter @dpmedia/infra dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "check": "vp check",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "web:start": "pnpm --filter web start",
    "web:lint": "pnpm --filter web lint",
    "web:test": "pnpm --filter web test",
    "web:test:ui": "pnpm --filter web test:ui",
    "web:test:coverage": "pnpm --filter web test:coverage",
    "web:test:e2e": "pnpm --filter web test:e2e",
    "web:test:e2e:ui": "pnpm --filter web test:e2e:ui",
    "web:test:e2e:debug": "pnpm --filter web test:e2e:debug",
    "arts:dev": "pnpm --filter arts dev",
    "arts:build": "pnpm --filter arts build",
    "arts:start": "pnpm --filter arts start",
    "arts:test": "pnpm --filter arts test",
    "fix": "vp check --fix",
    "typecheck": "turbo run check-types",
    "test": "turbo run test",
    "infra:plan": "pnpm --filter @dpmedia/infra plan",
    "deploy": "pnpm --filter @dpmedia/infra run deploy",
    "db:generate:arts": "pnpm --filter @dpmedia/db db:generate:arts",
    "db:generate:music": "pnpm --filter @dpmedia/db db:generate:music",
    "migration:export": "pnpm --filter @dpmedia/db migration:export",
    "migration:clerk": "pnpm --filter @dpmedia/auth import:clerk"
  },
  "dependencies": {
    "@dpmedia/env": "workspace:*",
    "@t3-oss/env-core": "^0.13.10",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dpmedia/config": "workspace:*",
    "@types/node": "^20.19.28",
    "concurrently": "^9.2.1",
    "portless": "^0.15.1",
    "turbo": "^2.6.3",
    "typescript": "catalog:",
    "ultracite": "7.2.4",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3"
  },
  "packageManager": "pnpm@10.19.0"
}
