{
  "name": "dpmedia",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:server\"",
    "dev:web": "turbo -F web dev",
    "dev:server": "cd apps/server && uv run python manage.py runserver",
    "dev:all": "turbo run dev --parallel",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@dpmedia/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dpmedia/config": "workspace:*",
    "concurrently": "^9.2.1",
    "oxfmt": "^0.19.0",
    "oxlint": "^1.34.0",
    "turbo": "^2.6.3",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.19.0"
}
