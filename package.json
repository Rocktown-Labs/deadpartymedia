{
  "name": "dpmedia",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --parallel -F web -F server",
    "dev:web": "turbo -F web dev",
    "dev:all": "turbo run dev --parallel",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@dpmedia/env": "workspace:*",
    "@t3-oss/env-core": "^0.13.10",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dpmedia/config": "workspace:*",
    "concurrently": "^9.2.1",
    "oxfmt": "^0.19.0",
    "oxlint": "^1.34.0",
    "turbo": "^2.6.3",
    "typescript": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.7",
      "@types/react-dom": "^19.2.3"
    }
  },
  "packageManager": "pnpm@10.19.0"
}
