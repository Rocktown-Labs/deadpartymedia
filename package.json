{
  "name": "dpmedia",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@better-auth/expo": "1.4.9",
      "@convex-dev/better-auth": "^0.10.9",
      "better-auth": "1.4.9",
      "convex": "^1.31.2",
      "dotenv": "17.2.3",
      "typescript": "^5",
      "zod": "^4.1.13"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --parallel -F web -F native",
    "dev:web": "turbo -F web dev",
    "dev:arts": "turbo -F arts dev",
    "dev:native": "turbo -F native dev",
    "dev:all": "turbo run dev --parallel",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "check": "vp check",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "web:start": "pnpm --filter web start",
    "web:lint": "pnpm --filter web lint",
    "web:test": "pnpm --filter web test",
    "web:test:ui": "pnpm --filter web test:ui",
    "web:test:coverage": "pnpm --filter web test:coverage",
    "web:test:e2e": "pnpm --filter web test:e2e",
    "web:test:e2e:ui": "pnpm --filter web test:e2e:ui",
    "web:test:e2e:debug": "pnpm --filter web test:e2e:debug",
    "web:db:generate": "pnpm --filter web db:generate",
    "web:db:migrate": "pnpm --filter web db:migrate",
    "web:db:push": "pnpm --filter web db:push",
    "web:db:studio": "pnpm --filter web db:studio",
    "web:content:posts:decode-titles": "pnpm --filter web content:posts:decode-titles",
    "arts:dev": "pnpm --filter arts dev",
    "arts:build": "pnpm --filter arts build",
    "arts:start": "pnpm --filter arts start",
    "arts:test": "pnpm --filter arts test",
    "arts:db:generate": "pnpm --filter arts db:generate",
    "arts:db:migrate": "pnpm --filter arts db:migrate",
    "arts:db:push": "pnpm --filter arts db:push",
    "arts:db:studio": "pnpm --filter arts db:studio",
    "fix": "vp check --fix"
  },
  "dependencies": {
    "@dpmedia/env": "workspace:*",
    "@t3-oss/env-core": "^0.13.10",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dpmedia/config": "workspace:*",
    "@types/node": "^20.19.28",
    "concurrently": "^9.2.1",
    "portless": "^0.15.1",
    "turbo": "^2.6.3",
    "typescript": "catalog:",
    "ultracite": "7.2.4",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3"
  },
  "packageManager": "pnpm@10.19.0"
}
