    "db:generate:music": "drizzle-kit generate --config drizzle.music.config.ts",
    "migration:export": "tsx scripts/export-postgres.ts"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@dpmedia/config": "workspace:*",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "1.0.0-rc.5",
    "pg": "^8.16.3",
    "tsx": "^4.21.0",
    "typescript": "catalog:"
  }
}
