{
  "name": "@dpmedia/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./d1": "./src/d1/index.ts",
    "./d1/schema": "./src/d1/schema.ts"
  },
  "scripts": {
    "check-types": "tsc -p tsconfig.json --noEmit",
