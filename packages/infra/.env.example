# Copy to .env (ignored). Generate a separate stable secret for each stage.
BETTER_AUTH_SECRET=
WORKERS_SUBDOMAIN=rocktown-labs
# The API owns the central session; Media hosts the branded auth UI for both sites.
# Separate root domains always use host-only cookies.

# URLs and trusted origins default to the selected stage's Workers URLs.
# Local alchemy dev uses localhost:3001 and localhost:3002 automatically.
# ARTS_APP_URL=
# WEB_APP_URL=
# TRUSTED_ORIGINS=

# Default false. Enable only for the production DNS cutover.
BIND_DOMAINS=false
# Existing production arts bucket is retained and explicitly adopted.
ARTS_BUCKET_NAME=deadpartyarts
MUSIC_BUCKET_NAME=deadpartymedia
# Leave media URLs empty to serve new uploads through each app's API proxy.
ARTS_MEDIA_URL=
MUSIC_MEDIA_URL=

# Google callback: <API_WORKER_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_FROM=noreply@deadpartymedia.com
# Optional. Manage the MAIL_FROM subdomain in this Cloudflare zone via Alchemy.
# Use a distinct sending subdomain for each stage that manages one.
# MAIL_SENDING_ZONE_ID=
# Native Workers AI binding; no API token in the Worker.
AI_MODEL=@cf/zai-org/glm-5.3-flash
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
FW_API_URL=https://storefront-api.fourthwall.com/v1
FW_STOREFRONT_TOKEN=
FW_CHECKOUT_URL=
FW_ARTS_COLLECTION_ID=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.posthog.com
VITE_SENTRY_DSN=
