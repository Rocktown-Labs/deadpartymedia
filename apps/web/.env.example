# Web (Next.js) environment variables
#
# Copy one of the example files below depending on what you want:
# - .env.development.local.example -> for local dev (Neon dev branch)
# - .env.production.local.example  -> for prod-like runs (Neon main branch)
#
# This file exists as a minimal default template.

# Django API URL (if you are running the Django backend locally)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Database connection used by Next.js API routes / server code (Drizzle + Neon)
# Set this to your Neon connection string.
DATABASE_URL=

# Cloudflare Workers AI (event flyer extraction & WordPress post backfill)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional model override (defaults to @cf/zai-org/glm-5.3-flash, e.g. @cf/google/gemma-4-26b-a4b-it)
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-5.3-flash

