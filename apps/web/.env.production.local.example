# Production-like local runs (Neon main branch)
#
# Copy to: .env.production.local
#
# IMPORTANT: Replace <password> with the real Neon role password.
# This should NOT be committed.

NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Use the pooled connection string from Neon (Project → Connection Details → Pooled).
DATABASE_URL=postgresql://neondb_owner:<password>@ep-<branch>-<id>-pooler.<region>.aws.neon.tech/neondb?channel_binding=require&sslmode=require
