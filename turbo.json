{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", "dist/**"],
      "env": [
        "VITE_MEDIA_URL",
        "VITE_ARTS_URL",
        "VITE_POSTHOG_KEY",
        "VITE_POSTHOG_HOST",
        "VITE_SENTRY_DSN"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^check-types"]
    },
    "lint": {
      "cache": false
    }
  }
}
