{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", ".output/**", "dist/**"],
      "env": [
        "CLERK_PUBLISHABLE_KEY",
        "VITE_CLERK_PUBLISHABLE_KEY",
        "CLERK_SECRET_KEY",
        "DATABASE_URL",
        "SERVER_URL",
        "VITE_APP_TITLE",
        "CLOUDFLARE_R2_ACCOUNT_ID",
        "CLOUDFLARE_R2_ACCESS_KEY_ID",
        "CLOUDFLARE_R2_SECRET_ACCESS_KEY",
        "CLOUDFLARE_R2_BUCKET",
        "CLOUDFLARE_R2_PUBLIC_URL",
        "VITE_FW_API_URL",
        "NEXT_PUBLIC_FW_API_URL",
        "VITE_FW_STOREFRONT_TOKEN",
        "NEXT_PUBLIC_FW_STOREFRONT_TOKEN",
        "VITE_FW_CHECKOUT",
        "NEXT_PUBLIC_FW_CHECKOUT",
        "VITE_FW_ARTS_COLLECTION_ID",
        "NEXT_PUBLIC_FW_ARTS_COLLECTION_ID",
        "VITE_FOURTHWALL_ARTS_COLLECTION_ID",
        "NEXT_PUBLIC_FOURTHWALL_ARTS_COLLECTION_ID",
        "AI_GATEWAY_API_KEY",
        "GOOGLE_GENERATIVE_AI_API_KEY",
        "GEMINI_API_KEY"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "lint": {
      "cache": false
    }
  }
}
